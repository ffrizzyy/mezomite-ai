{
  "name": "mezomite-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bilingual marketing site for Mezomite.ai: consulting, audit, and digitization for Indonesian businesses.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:functions": "tsc -p functions/tsconfig.json",
    "og": "node scripts/og/render.mjs",
    "db:local": "wrangler d1 execute mezomite-db --local --file=./db/migrations/0001_init.sql",
    "db:remote": "wrangler d1 execute mezomite-db --remote --file=./db/migrations/0001_init.sql"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@cloudflare/workers-types": "^5.20261027.1",
    "@phosphor-icons/core": "^2.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
