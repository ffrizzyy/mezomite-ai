---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import LegalDoc from '../components/sections/LegalDoc.astro';
import { getCopy } from '../content/copy';
import { getLegal } from '../content/legal';

const locale = 'id' as const;
const t = getCopy(locale);
const legal = getLegal(locale);
const doc = legal.terms;
---

<Base
  locale={locale}
  routeKey="terms"
  title={t.pages.terms.title}
  description={t.pages.terms.description}
>
  <PageHeader
    eyebrow="Legal"
    title={doc.title}
    meta={[
      { label: t.common.updated, value: doc.updated },
      { label: locale === 'id' ? 'Berlaku untuk' : 'Applies to', value: 'mezomite.ai' },
    ]}
  />

  <section class="section section--flush" aria-label={doc.title}>
    <div class="container">
      <LegalDoc
        doc={doc}
        draft={legal.draft}
        draftNote={legal.draftNote}
        locale={locale}
        updatedLabel={t.common.updated}
      />
    </div>
  </section>
</Base>
