---
/**
 * One small drawing per audit step. These are content, not decoration: each
 * shows the shape of the step, and the text beside it carries the meaning.
 * Inline SVG so there is no image request and no layout shift.
 */
interface Props {
  kind: 'intake' | 'map' | 'measure' | 'score' | 'report';
  label: string;
}

const { kind, label } = Astro.props;
---

<svg class="diagram" viewBox="0 0 200 120" role="img" aria-label={label}>
  <g class="diagram__grid" aria-hidden="true">
    <line x1="0" y1="30" x2="200" y2="30" />
    <line x1="0" y1="60" x2="200" y2="60" />
    <line x1="0" y1="90" x2="200" y2="90" />
    <line x1="40" y1="0" x2="40" y2="120" />
    <line x1="80" y1="0" x2="80" y2="120" />
    <line x1="120" y1="0" x2="120" y2="120" />
    <line x1="160" y1="0" x2="160" y2="120" />
  </g>

  {
    kind === 'intake' && (
      <g class="diagram__ink" aria-hidden="true">
        <rect x="18" y="34" width="48" height="56" rx="2" />
        <line x1="28" y1="48" x2="56" y2="48" />
        <line x1="28" y1="58" x2="56" y2="58" />
        <line x1="28" y1="68" x2="46" y2="68" />
        <path d="M74 62h28" />
        <path d="M96 56l8 6-8 6" />
        <rect x="112" y="46" width="64" height="32" rx="2" />
        <line x1="124" y1="58" x2="164" y2="58" />
        <line x1="124" y1="66" x2="152" y2="66" />
      </g>
    )
  }

  {
    kind === 'map' && (
      <g class="diagram__ink" aria-hidden="true">
        <rect x="12" y="48" width="38" height="24" rx="2" />
        <rect x="82" y="24" width="38" height="24" rx="2" />
        <rect x="82" y="72" width="38" height="24" rx="2" />
        <rect x="152" y="48" width="38" height="24" rx="2" />
        <path d="M50 60h20l12-24" />
        <path d="M50 60h20l12 24" />
        <path d="M120 36h20l12 24" />
        <path d="M120 84h20l12-24" />
        <circle cx="70" cy="60" r="2.5" class="diagram__dot" />
        <circle cx="140" cy="60" r="2.5" class="diagram__dot" />
      </g>
    )
  }

  {
    kind === 'measure' && (
      <g class="diagram__ink" aria-hidden="true">
        <path d="M16 44v34" />
        <path d="M184 44v34" />
        <path d="M16 61h168" />
        <path d="M16 52h14M16 70h14M184 52h-14M184 70h-14" />
        <path d="M58 50v22M98 50v22M138 50v22" class="diagram__thin" />
        <rect x="92" y="92" width="52" height="14" rx="2" class="diagram__accent" />
      </g>
    )
  }

  {
    kind === 'score' && (
      <g class="diagram__ink" aria-hidden="true">
        <path d="M22 28v64" />
        <path d="M22 92h156" />
        <rect x="36" y="36" width="112" height="10" class="diagram__accent" />
        <rect x="36" y="56" width="78" height="10" />
        <rect x="36" y="76" width="46" height="10" />
        <line x1="22" y1="100" x2="178" y2="100" class="diagram__thin" />
      </g>
    )
  }

  {
    kind === 'report' && (
      <g class="diagram__ink" aria-hidden="true">
        <rect x="34" y="20" width="92" height="80" rx="2" />
        <rect x="46" y="32" width="92" height="80" rx="2" class="diagram__back" />
        <line x1="58" y1="52" x2="122" y2="52" />
        <line x1="58" y1="64" x2="122" y2="64" />
        <line x1="58" y1="76" x2="100" y2="76" />
        <path d="M138 96l12 12 22-28" class="diagram__check" />
      </g>
    )
  }
</svg>

<style>
  .diagram {
    width: 100%;
    height: auto;
    max-width: 18rem;
    overflow: visible;
  }

  .diagram__grid line {
    stroke: var(--grid-line);
    stroke-width: 1;
  }

  .diagram__ink {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .diagram__ink rect {
    fill: var(--surface);
    rx: 2;
  }

  .diagram__ink .diagram__accent {
    fill: var(--accent-soft);
    stroke: var(--accent);
  }

  .diagram__ink .diagram__back {
    fill: var(--bg);
  }

  .diagram__ink .diagram__thin {
    stroke: var(--border);
  }

  .diagram__ink .diagram__dot {
    fill: var(--accent);
    stroke: none;
  }

  .diagram__ink .diagram__check {
    stroke: var(--accent);
    stroke-width: 2;
  }
</style>
