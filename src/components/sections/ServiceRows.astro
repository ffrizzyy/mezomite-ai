---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { getCopy } from '../../content/copy';
import { route, type Locale } from '../../lib/i18n';
import { formatIDR } from '../../lib/format';
import { SERVICES } from '../../data/services';

interface Props {
  locale: Locale;
  /** Full rows state deliverable, includes, and the named next step (F-003). */
  full?: boolean;
}

const { locale, full = false } = Astro.props;
const t = getCopy(locale);
const servicesHref = route('services', locale);
---

{
  full ? (
    <div class="service-rows">
      {SERVICES.map((service) => (
        <article class="service" id={service.slug} data-spotlight>
          <div class="service__head">
            <span class="index-num service__index">{String(service.order).padStart(2, '0')}</span>
            <h3 class="service__title">{service.title[locale]}</h3>
            <span class="badge service__duration">{service.duration[locale]}</span>
            <p class="service__price">
              <span class="label">{t.services.priceLabel}</span>
              <span class="price price--lg">{formatIDR(service.price)}</span>
            </p>
          </div>

          <div class="service__body">
            <div class="service__intro">
              <p class="service__summary">{service.summary[locale]}</p>

              <dl class="service__spec">
                <div>
                  <dt class="label">{t.common.deliverable}</dt>
                  <dd>{service.deliverable[locale]}</dd>
                </div>
                <div>
                  <dt class="label">{t.common.bestFor}</dt>
                  <dd>{service.bestFor[locale]}</dd>
                </div>
              </dl>
            </div>

            <div class="service__includes">
              <p class="label">{t.common.includes}</p>
              <ul class="ticks">
                {service.includes[locale].map((item) => (
                  <li>
                    <Icon name="check" size={14} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="service__next">
              <span class="label">{t.common.nextStep}</span>
              <a class="link service__next-link" href={route(service.nextStep.key, locale)}>
                {service.nextStep.label[locale]}
                <Icon name="arrow-right" size={16} />
              </a>
              <Button
                href={`${route('booking', locale)}?package=${service.slug}`}
                variant="quiet"
                size="sm"
                icon="calendar-check"
                iconPosition="start"
              >
                {t.common.bookCall}
              </Button>
            </div>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <ul class="service-list">
      {SERVICES.map((service) => (
        <li>
          <a
            class="service-row"
            href={`${servicesHref}#${service.slug}`}
            data-service-link={service.slug}
            data-spotlight
          >
            <span class="index-num service-row__index">{String(service.order).padStart(2, '0')}</span>
            <span class="service-row__copy">
              <span class="service-row__title">{service.title[locale]}</span>
              <span class="service-row__summary">{service.summary[locale]}</span>
            </span>
            <span class="service-row__meta">
              <span class="price">{formatIDR(service.price)}</span>
              <span class="label service-row__duration">{service.duration[locale]}</span>
            </span>
            <span class="service-row__arrow">
              <Icon name="arrow-right" size={18} />
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  /* ------------------------------------------------------------- Compact */
  .service-list {
    border-top: 1px solid var(--border-strong);
  }

  .service-list li {
    border-bottom: 1px solid var(--border);
  }

  .service-row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto 2rem;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-3);
    color: var(--text);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-standard);
  }

  .service-row:hover {
    background: var(--surface);
  }

  .service-row__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .service-row__title {
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: -0.012em;
  }

  .service-row__summary {
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 62ch;
  }

  .service-row__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
    text-align: right;
  }

  .service-row__arrow {
    display: inline-flex;
    color: var(--text-muted);
    transition: transform var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard);
  }

  .service-row:hover .service-row__arrow {
    color: var(--accent);
    transform: translateX(2px);
  }

  /* ---------------------------------------------------------------- Full */
  .service-rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .service {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--surface);
  }

  .service__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border);
  }

  .service__title {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-display);
  }

  .service__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
    text-align: right;
  }

  .service__body {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-top: var(--space-5);
  }

  .service__summary {
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--text);
    max-width: 46ch;
  }

  .service__spec {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .service__spec dt {
    margin-bottom: var(--space-1);
  }

  .service__spec dd {
    color: var(--text-muted);
    max-width: 58ch;
  }

  .service__includes {
    padding-left: clamp(0rem, 3vw, 2rem);
    border-left: 1px solid var(--border);
  }

  .service__includes .label {
    margin-bottom: var(--space-3);
  }

  .ticks {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-small);
  }

  .ticks li {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .ticks svg {
    margin-top: 0.2em;
    color: var(--accent);
  }

  .service__next {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .service__next-link {
    font-weight: 600;
    color: var(--accent);
  }

  @media (max-width: 899.98px) {
    .service__head {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .service__price {
      grid-column: 2 / -1;
      align-items: flex-start;
      text-align: left;
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-3);
    }

    .service__body {
      grid-template-columns: 1fr;
    }

    .service__includes {
      padding-left: 0;
      padding-top: var(--space-5);
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 599.98px) {
    .service-row {
      grid-template-columns: 2rem minmax(0, 1fr) 1.5rem;
      gap: var(--space-3);
    }

    .service-row__meta {
      grid-column: 2 / 3;
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-3);
      text-align: left;
    }

    .service-row__arrow {
      grid-column: 3 / 4;
      grid-row: 1 / 2;
    }

    .service-row__duration {
      display: none;
    }
  }
</style>
