---
import Button from '../ui/Button.astro';
import MagicRings from '../reactbits/MagicRings';
import { getCopy } from '../../content/copy';
import { route, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  eyebrow?: string;
  title?: string;
  lead?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const {
  eyebrow = t.home.ctaEyebrow,
  title = t.home.ctaTitle,
  lead = t.home.ctaLead,
  primaryLabel = t.home.ctaPrimary,
  primaryHref = route('booking', locale),
  secondaryLabel = t.home.ctaSecondary,
  secondaryHref = route('contact', locale),
} = Astro.props;
---

<section class="section cta-band" aria-labelledby="cta-band-title">
  <div class="container">
    <div class="cta-band__panel panel--ink">
      <div class="cta-band__rings">
        <MagicRings
          color="#3E8CC0"
          colorTwo="#1B5F8F"
          motion="pulse"
          ringCount={7}
          speed={0.5}
          lineThickness={1.4}
          glow={1.5}
          baseRadius={0.24}
          radiusStep={0.07}
          taper={1.2}
          opacity={1}
          hoverScale={1.04}
          hoverIntensity={0.6}
          clickBurst={false}
          parallax={0.02}
          theme="dark"
          client:only="react"
        />
      </div>
      <div class="cta-band__copy">
        <p class="label label--ticked label--accent">{eyebrow}</p>
        <h2 id="cta-band-title">{title}</h2>
        <p class="lede">{lead}</p>
      </div>
      <div class="cta-band__actions">
        <Button href={primaryHref} icon="calendar-check" iconPosition="start">{primaryLabel}</Button>
        <Button href={secondaryHref} variant="secondary" icon="paper-plane-tilt" iconPosition="start">
          {secondaryLabel}
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band__panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(2rem, 4vw, 3.25rem);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-2);
  }

  /* The rings sit behind the panel's own content, clipped to its radius, and
     faded out before they reach the copy column so contrast never depends on
     where a ring happens to be. The box is square: the component normalises its
     geometry against the shorter side, and a square keeps the mask and the
     drawing on the same radius. */
  .cta-band__rings {
    position: absolute;
    right: 2%;
    bottom: -42%;
    width: min(58%, 30rem);
    aspect-ratio: 1;
    opacity: 0.9;
    -webkit-mask-image: radial-gradient(closest-side, #000 34%, transparent 96%);
    mask-image: radial-gradient(closest-side, #000 34%, transparent 96%);
    pointer-events: none;
  }

  .cta-band__copy,
  .cta-band__actions {
    position: relative;
    z-index: 1;
  }

  .cta-band__copy h2 {
    margin-top: var(--space-3);
    max-width: 24ch;
  }

  .cta-band__copy .lede {
    margin-top: var(--space-3);
    font-size: var(--text-body);
    max-width: 52ch;
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: flex-end;
  }

  @media (max-width: 899.98px) {
    .cta-band__panel {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .cta-band__actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 599.98px) {
    .cta-band__actions > :global(.btn) {
      width: 100%;
    }
  }
</style>
