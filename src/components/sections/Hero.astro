---
import SplitText from '../reactbits/SplitText';
import ProcessGraph from '../reactbits/ProcessGraph';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { getCopy } from '../../content/copy';
import { route, type Locale } from '../../lib/i18n';
import { formatIDR } from '../../lib/format';
import { PACKAGES } from '../../data/packages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const entry = PACKAGES.find((item) => item.entry) ?? PACKAGES[0];
const bookingHref = route('booking', locale);
const methodHref = route('method', locale);
---

<section class="hero wash wash--fade" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="label label--ticked label--accent rise">{t.home.eyebrow}</p>

      <h1 id="hero-title" class="hero__title">
        <SplitText text={t.home.title} as="span" />
      </h1>

      <p class="hero__lead rise" style="--rise-delay: 90ms">{t.home.lead}</p>

      <div class="hero__offer rise" style="--rise-delay: 140ms">
        <div class="hero__price">
          <span class="label">{t.home.priceLabel}</span>
          <span class="price price--xl">{formatIDR(entry.price)}</span>
        </div>
        <p class="hero__price-note">{t.home.priceNote}</p>
      </div>

      <div class="hero__actions rise" style="--rise-delay: 190ms">
        <Button href={bookingHref} icon="calendar-check" iconPosition="start">
          {t.home.primaryCta}
        </Button>
        <Button href={methodHref} variant="secondary" icon="arrow-right">
          {t.home.secondaryCta}
        </Button>
      </div>

      <p class="hero__note rise" style="--rise-delay: 230ms">
        <Icon name="clock-countdown" size={16} />
        {t.home.specNote}
      </p>
    </div>

    <aside class="hero__panel rise" style="--rise-delay: 120ms">
      <div class="hero__panel-head">
        <p class="label label--ticked">{t.home.specTitle}</p>
        <span class="badge badge--accent">{t.common.entryPackage}</span>
      </div>

      <dl class="hero__spec">
        {
          t.home.specRows.map((row) => (
            <div class="hero__spec-row">
              <dt>{row.key}</dt>
              <dd>{row.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="hero__graph">
        <p class="label label--ticked">{t.home.graphTitle}</p>
        {/* Loaded eagerly, not on idle. The page background is a full-viewport
            shader that never stops, and on a software renderer it can hold the
            main thread busy enough that an idle callback is never handed a
            slot. The diagram is content; the rings are decoration, so the
            content goes first. */}
        <ProcessGraph labels={t.home.graphNodes} client:load />
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 7.5vw, 6.5rem) clamp(3.5rem, 6vw, 5.5rem);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.92fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero__copy {
    position: relative;
    z-index: 1;
  }

  .hero__title {
    margin-top: var(--space-5);
    max-width: 17ch;
  }

  .hero__lead {
    margin-top: var(--space-6);
    font-size: var(--text-lead);
    line-height: 1.55;
    letter-spacing: -0.005em;
    color: var(--text-muted);
    max-width: 46ch;
  }

  .hero__offer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .hero__price {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .hero__price-note {
    font-size: var(--text-small);
    color: var(--text-muted);
    max-width: 30ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero__note {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    font-size: var(--text-small);
    color: var(--text-muted);
  }

  .hero__panel {
    position: relative;
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-2);
  }

  .hero__panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .hero__spec {
    margin-top: var(--space-2);
  }

  .hero__spec-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-small);
  }

  .hero__spec-row dt {
    color: var(--text-muted);
  }

  .hero__spec-row dd {
    text-align: right;
    font-weight: 500;
  }

  .hero__graph {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .hero__graph .label {
    margin-bottom: var(--space-4);
  }

  @media (max-width: 1023.98px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .hero__panel {
      max-width: 32rem;
    }
  }

  @media (max-width: 599.98px) {
    .hero__title {
      max-width: none;
      /* `balance` fills the longest lines first and can leave a single short
         word on its own line; `pretty` keeps the last two lines even. */
      text-wrap: pretty;
    }

    .hero__actions > :global(.btn) {
      width: 100%;
    }

    .hero__offer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
