---
import MethodFlow from '../reactbits/MethodFlow';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import SectionHead from '../ui/SectionHead.astro';
import { getCopy } from '../../content/copy';
import { route, type Locale } from '../../lib/i18n';
import { METHOD_STEPS } from '../../data/method';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const label =
  locale === 'id'
    ? `Alur lima langkah audit: ${METHOD_STEPS.map((step) => step.title.id).join(', ')}.`
    : `The five audit steps: ${METHOD_STEPS.map((step) => step.title.en).join(', ')}.`;
---

<section class="section" aria-labelledby="method-teaser-title">
  <div class="container">
    <SectionHead
      id="method-teaser-title"
      eyebrow={t.home.methodEyebrow}
      title={t.home.methodTitle}
      lead={t.home.methodLead}
      split
    >
      <Button href={route('method', locale)} variant="secondary" icon="arrow-right">
        {t.home.methodCta}
      </Button>
    </SectionHead>

    <div class="method-teaser__diagram">
      <MethodFlow label={label} client:visible />
    </div>

    <ol class="method-teaser__steps">
      {
        METHOD_STEPS.map((step) => (
          <li>
            <a class="method-teaser__step" href={`${route('method', locale)}#${step.id}`}>
              <span class="index-num">{step.number}</span>
              <span class="method-teaser__name">{step.title[locale]}</span>
              <span class="method-teaser__summary">{step.summary[locale]}</span>
              <Icon name="arrow-right" size={16} />
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .method-teaser__diagram {
    padding: var(--space-6) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--surface);
    overflow: hidden;
  }

  .method-teaser__steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .method-teaser__steps li {
    border-left: 1px solid var(--border);
  }

  .method-teaser__steps li:first-child {
    border-left: 0;
  }

  .method-teaser__step {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-4) var(--space-4) var(--space-5);
    color: var(--text);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-standard);
  }

  .method-teaser__step:hover {
    background: var(--surface);
  }

  .method-teaser__step svg {
    margin-top: auto;
    color: var(--text-muted);
    transition: transform var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard);
  }

  .method-teaser__step:hover svg {
    color: var(--accent);
    transform: translateX(2px);
  }

  .method-teaser__name {
    font-weight: 600;
    font-size: var(--text-small);
    line-height: 1.35;
  }

  .method-teaser__summary {
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--text-muted);
  }

  @media (max-width: 1023.98px) {
    .method-teaser__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .method-teaser__steps li {
      border-top: 1px solid var(--border);
    }

    .method-teaser__steps li:nth-child(odd) {
      border-left: 0;
    }

    .method-teaser__steps li:first-child,
    .method-teaser__steps li:nth-child(2) {
      border-top: 0;
    }
  }

  @media (max-width: 599.98px) {
    .method-teaser__steps {
      grid-template-columns: 1fr;
    }

    .method-teaser__steps li {
      border-left: 0;
      border-top: 1px solid var(--border);
    }

    .method-teaser__steps li:nth-child(2) {
      border-top: 1px solid var(--border);
    }
  }
</style>
