---
import Icon from '../ui/Icon.astro';
import type { FaqItem } from '../../content/copy/types';

interface Props {
  items: FaqItem[];
  /** Visible heading for the list. The page usually renders its own heading. */
  label?: string;
}

const { items, label } = Astro.props;
---

<div class="faq" aria-label={label}>
  {
    items.map((item, index) => (
      <details class="faq__item">
        <summary class="faq__question">
          <span class="index-num faq__index">{String(index + 1).padStart(2, '0')}</span>
          <span class="faq__text">{item.q}</span>
          <span class="faq__icon" aria-hidden="true">
            <Icon name="plus" size={16} />
          </span>
        </summary>
        <div class="faq__answer">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--border-strong);
  }

  .faq__item {
    border-bottom: 1px solid var(--border);
  }

  .faq__question {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
    align-items: start;
    gap: var(--space-4);
    padding-block: var(--space-5);
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:hover .faq__text {
    color: var(--accent);
  }

  .faq__text {
    font-weight: 600;
    line-height: 1.45;
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .faq__icon {
    display: inline-flex;
    justify-content: flex-end;
    color: var(--text-muted);
    transition: transform var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard);
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    color: var(--accent);
  }

  .faq__answer {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
  }

  .faq__answer p {
    grid-column: 2 / 3;
    color: var(--text-muted);
    max-width: 68ch;
    line-height: 1.65;
  }

  @media (max-width: 599.98px) {
    .faq__question,
    .faq__answer {
      grid-template-columns: minmax(0, 1fr) 1.5rem;
      gap: var(--space-3);
    }

    .faq__index {
      display: none;
    }

    .faq__answer p {
      grid-column: 1 / 2;
    }
  }
</style>
