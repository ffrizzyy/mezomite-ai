---
/**
 * Renders one legal document in two columns: a short table of contents and the
 * text. The draft notice is part of the page until a lawyer signs the copy off,
 * so it cannot be forgotten at launch.
 */
import Icon from '../ui/Icon.astro';
import type { LegalDoc } from '../../content/legal/types';
import type { Locale } from '../../lib/i18n';

interface Props {
  doc: LegalDoc;
  draft: boolean;
  draftNote: string;
  locale: Locale;
  updatedLabel: string;
}

const { doc, draft, draftNote, locale, updatedLabel } = Astro.props;
const contentsLabel = locale === 'id' ? 'Isi halaman' : 'On this page';
---

<div class="legal-layout">
  <aside class="legal-toc">
    <p class="label label--ticked">{contentsLabel}</p>
    <ol class="legal-toc__list">
      {
        doc.sections.map((section, index) => (
          <li>
            <a href={`#bagian-${index + 1}`}>{section.heading}</a>
          </li>
        ))
      }
    </ol>
  </aside>

  <article class="legal-doc">
    {draft && (
      <div class="alert alert--info legal-draft" role="note">
        <Icon name="warning-circle" size={18} />
        <p>{draftNote}</p>
      </div>
    )}

    <p class="legal-doc__updated">
      <span class="label">{updatedLabel}</span>
      <span class="tabular">{doc.updated}</span>
    </p>

    <p class="lede legal-doc__intro">{doc.intro}</p>

    <div class="prose">
      {
        doc.sections.map((section, index) => (
          <section id={`bagian-${index + 1}`} class="legal-section">
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {section.list && (
              <ul>
                {section.list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </div>
  </article>
</div>

<style>
  .legal-layout {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .legal-toc {
    position: sticky;
    top: calc(var(--header-height) + var(--space-6));
    padding-top: var(--space-2);
  }

  .legal-toc__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-left: var(--space-4);
    border-left: 1px solid var(--border);
    font-size: var(--text-small);
  }

  .legal-toc__list a {
    color: var(--text-muted);
    text-decoration: none;
    line-height: 1.45;
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .legal-toc__list a:hover {
    color: var(--accent);
  }

  .legal-doc {
    min-width: 0;
    max-width: 46rem;
  }

  .legal-draft {
    margin-bottom: var(--space-6);
    align-items: flex-start;
  }

  .legal-draft :global(svg) {
    margin-top: 0.15em;
    color: var(--warning);
  }

  .legal-doc__updated {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: baseline;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-small);
    color: var(--text-muted);
  }

  .legal-doc__intro {
    margin-top: var(--space-6);
    max-width: 62ch;
  }

  .legal-section {
    scroll-margin-top: calc(var(--header-height) + var(--space-6));
  }

  .legal-section:first-child h2 {
    margin-top: var(--space-8);
  }

  @media (max-width: 899.98px) {
    .legal-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .legal-toc {
      position: static;
    }

    .legal-toc__list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--border);
      padding-top: var(--space-3);
    }
  }
</style>
