# Copy this file to .env and fill in the values.
# Only the Cloudflare Pages Function reads these. Nothing is exposed to the browser.

# Cloudflare Turnstile (bot protection). Public site key is passed to the widget.
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_your_site_key
TURNSTILE_SECRET_KEY=0x4AAAAAAA_your_secret_key

# Resend transactional email.
RESEND_API_KEY=re_your_api_key
MAIL_FROM="Mezomite.ai <halo@mezomite.ai>"
MAIL_TO=halo@mezomite.ai

# Public contact details used in copy.
PUBLIC_WHATSAPP_NUMBER=6281234567890
PUBLIC_CONTACT_EMAIL=halo@mezomite.ai

# The D1 binding is configured in wrangler.toml, not here.
