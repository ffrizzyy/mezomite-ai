# Security and caching headers for Cloudflare Pages.
#
# script-src and style-src are deliberately absent: Astro emits them per page in
# a <meta http-equiv="content-security-policy"> tag, because the island bootstrap
# is an inline script whose hash changes per page. A hand-written header cannot
# carry those hashes. What stays here is the part a meta tag cannot express
# (frame-ancestors is ignored in meta) and the non-CSP headers.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'none'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/init.js
  Cache-Control: public, max-age=3600

/api/*
  X-Robots-Tag: noindex
  Cache-Control: no-store
